/deploy/mitmproxy/state/*
!/deploy/mitmproxy/state/.gitkeep
.DS_Store
.tools/
.venv/
__pycache__/
*.pyc
build/
dist/
*.egg-info/

# Production logs and data stay on the droplet; the repository is public.
# tests/maintenance/test_repo_hygiene.py fails CI if any of this is tracked.
/logs/
*.log
*.log.[0-9]*
*.zst
*.pcap
*.pcapng
*.har
.env
.env.*
/deploy/nginx/html/demo/
